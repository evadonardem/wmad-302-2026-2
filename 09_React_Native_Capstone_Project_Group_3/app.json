{
  "expo": {
    "name": "Cookbook Capstone",
    "slug": "09-cookbook-capstone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wmad302.cookbook"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.wmad302.cookbook"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "scheme": "cookbook",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cookbook-capstone"
      }
    },
    "owner": "wmad302"
  }
}
