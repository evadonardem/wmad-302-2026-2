    "collectCoverageFrom": [
      "utils/**/*.{ts,tsx}",
      "context/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "services/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/__tests__/**"
    ]
  },
  "private": true
